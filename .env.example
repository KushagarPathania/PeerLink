# Copy to .env and fill in real values. .env is git-ignored; never commit credentials.

# --- Coordination server -------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/peerlink
DB_USERNAME=peerlink
DB_PASSWORD=replace-with-a-strong-password
SERVER_PORT=8080
# Session cookie: set SESSION_COOKIE_SECURE=true whenever the server is reached over HTTPS (production).
SESSION_COOKIE_SECURE=false
SESSION_TIMEOUT=30m
# Peer presence: agents heartbeat every interval; peers are offline after stale-timeout (>= 2x interval).
PEER_HEARTBEAT_INTERVAL=15s
PEER_STALE_TIMEOUT=60s
PEER_SWEEP_INTERVAL=15s
# Lifetime of a direct-connection ticket (5s..10m).
PEER_CONNECTION_TICKET_TTL=60s
# File transfers: unclaimed requests and stalled transfers fail after these times.
PEER_TRANSFER_REQUEST_TTL=30m
PEER_TRANSFER_STALL_TIMEOUT=3m

# --- Optional local PostgreSQL via docker compose (uses the values above) ------
POSTGRES_DB=peerlink

# --- Peer agent ----------------------------------------------------------------
PEERLINK_SERVER_URL=http://localhost:8080
PEERLINK_AGENT_PORT=9090
# Leave empty to use ~/PeerLink/downloads
PEERLINK_DOWNLOAD_DIR=
# Set both to keep a registered device online (values come from the dashboard; never commit them).
PEERLINK_PEER_ID=
PEERLINK_AGENT_CREDENTIAL=
PEERLINK_HEARTBEAT_INTERVAL=15
# Direct peer connections: 127.0.0.1 accepts only this machine; use this device's LAN IP (or 0.0.0.0)
# so peers on other devices can connect. PEERLINK_AGENT_PORT above is the listening port.
PEERLINK_LISTEN_HOST=127.0.0.1
PEERLINK_LISTEN_ENABLED=true
PEERLINK_MAX_CONNECTIONS=8
# File transfer: private agent data (list of shared files), size limit, concurrency.
PEERLINK_DATA_DIR=
PEERLINK_MAX_FILE_SIZE=1GiB
PEERLINK_MAX_TRANSFERS=2
